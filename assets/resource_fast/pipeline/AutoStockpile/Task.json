{
    "AutoStockpileSelectedProductClickFailed": {"focus": {"Node.Recognition.Failed": "商品识别出错"}},
    "新建节点4": {"desc": "在这里处理没有解锁物资调度", "action": {"type": "Custom", "param": {}}},
    "AutoStockpileDecision": {
        "desc": "统一识别与决策：CustomRecognition识别商品，CustomAction选择购买",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "AutoStockpile.Recognition",
                "custom_recognition_param": {}
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AutoStockpile.SelectItem",
                "custom_action_param": {
                    "strategy": "Recommend",
                    "overflow_mode": false,
                    "sunday_mode": false,
                    "fallback_threshold": 1000,
                    "price_limits": {
                        "valley_iv_tier1": 1000,
                        "valley_iv_tier2": 1400,
                        "valley_iv_tier3": 1700,
                        "wuling_tier1": 1700
                    }
                }
            }
        },
        "next": [
            "AutoStockpileSelectedProductClick",
            "AutoStockpileNoCandidate"
        ]
    },
    "AutoStockpileSelectedProductClick": {
        "desc": "点击决策选中的商品",
        "enabled": false,
        "recognition": {"type": "TemplateMatch", "param": {"template": "", "threshold": [0.8]}},
        "action": {"type": "Click", "param": {}},
        "post_wait_freezes": 80,
        "on_error": ["AutoStockpileSelectedProductClickFailed"]
    },
    "AutoStockpileNoCandidate": {
        "desc": "决策未找到合格商品时的兜底节点",
        "focus": {"Node.Recognition.Succeeded": "无合格商品，跳过本次购买"}
    },
    "AutoStockpilerEnterStore": {"desc": "进入物资调度界面", "recognition": {"type": "TemplateMatch", "param": {"roi": [
                    885,
                    300,
                    135,
                    143
                ], "template": [
                    "AutoStockpile/StockRedistributionButton.png"
                ], "threshold": [0.8]}}, "action": {"type": "Click", "param": {}}, "post_wait_freezes": 80, "next": [
            "AutoStockpileGotoElasticGoods",
            "AutoStockpileCheckInStore"
        ]},
    "AutoStockpileGotoElasticGoods": {
        "desc": "选择弹性物资调度",
        "recognition": {"type": "TemplateMatch", "param": {"roi": [
                    338,
                    57,
                    69,
                    62
                ], "template": [
                    "AutoStockpile/ElasticGoodsButton.png",
                    "AutoStockpile/ElasticGoodsButtonSelected.png"
                ], "threshold": [0.8]}},
        "action": {"type": "Click", "param": {}},
        "post_wait_freezes": 80,
        "next": ["AutoStockpileGotoBottom"]
    },
    "AutoStockpileCheckInStore": {"recognition": {"type": "TemplateMatch", "param": {"roi": [
                    54,
                    58,
                    60,
                    54
                ], "template": [
                    "AutoStockpile/StapleGoodsButtonSelected.png"
                ]}}, "focus": {"Node.Recognition.Succeeded": "该地区未解锁弹性物资调度，跳过该地区"}},
    "AutoStockpileGotoBottom": {
        "desc": "将所有可购买物品展示在窗口中",
        "recognition": {"type": "TemplateMatch", "param": {"roi": [
                    8,
                    152,
                    52,
                    541
                ], "template": ["AutoStockpile/ElasticGoodsButtonSide.png"], "threshold": [0.8]}},
        "action": {"type": "Click", "param": {"target_offset": [
                    10,
                    10,
                    -10,
                    -10
                ]}},
        "post_wait_freezes": 80,
        "next": ["AutoStockpileMoveMouse"]
    },
    "AutoStockpileTask": {"desc": "开始自动囤货任务", "next": [
            "EnsureInRegionalDevelopment",
            "[JumpBack]SceneEnterMenuRegionalDevelopment"
        ]},
    "EnsureInRegionalDevelopment": {
        "recognition": {"type": "And", "param": {"all_of": ["InRegionalDevelopment"]}},
        "action": {
            "type": "Custom",
            "param": {"custom_action": "SubTask", "custom_action_param": {"sub": ["AutoStockpileChangeReigonTask"]}}
        },
        "next": [
            "AutoStockpilerEnterStore",
            "新建节点4"
        ]
    },
    "AutoStockpileChangeReigonTask": {"next": ["[Anchor]AutoStockpileGotoTargetReigon"]},
    "AutoStockpileMoveMouse": {"desc": "避免鼠标遮挡", "action": {"type": "TouchMove", "param": {"target": [
                    891,
                    71,
                    24,
                    16
                ]}}, "next": ["AutoStockpileDecision"]}
}
